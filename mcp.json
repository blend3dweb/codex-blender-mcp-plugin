{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "codex-blender": {
      "type": "stdio",
      "command": "python",
      "args": [
        "${PLUGIN_ROOT}/scripts/serve.py"
      ],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "BLENDER_MCP_DISABLE_TELEMETRY": "1",
        "BLENDER_HOST": "127.0.0.1",
        "BLENDER_PORT": "9876"
      }
    }
  }
}
